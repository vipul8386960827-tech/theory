      "seed": 175538416,
      "version": 652,
      "versionNonce": 61480976,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775638396615,
      "link": null,
      "locked": false,
      "text": "Auth\n1.User will enter phone number\n2.Validate phone number regex\n3.call request api\n4.start timer to resend\n5. user enters the otp\n6.automatic read otp\n    1.WebOtp browser api\n    2.OTP credentials in windows\nconst controller = new AbortController()\notp = await navigator.credentials.get(\n        otp:transport[\"sms\"]\n        signal : controller.signal\n)",
      "fontSize": 8.67532467532466,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Auth\n1.User will enter phone number\n2.Validate phone number regex\n3.call request api\n4.start timer to resend\n5. user enters the otp\n6.automatic read otp\n    1.WebOtp browser api\n    2.OTP credentials in windows\nconst controller = new AbortController()\notp = await navigator.credentials.get(\n        otp:transport[\"sms\"]\n        signal : controller.signal\n)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y4vJDwy5iDrvu7UYJksRc",
      "type": "text",
      "x": 783.0068109685724,
