      "boundElements": [],
      "updated": 1775639547360,
      "link": null,
      "locked": false,
      "text": "Location\n1.navigator.permission.query({name:\"geolocation\"})\n2.granted => google maps \n3.denied => manual address(geocoding)\n4.Locate me=> show instructions\n5Maps\n    1. Pin Vs Map Movement\n    2.Debounceing so that we dont call api on every pixel change",
      "fontSize": 9.272727272727245,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Location\n1.navigator.permission.query({name:\"geolocation\"})\n2.granted => google maps \n3.denied => manual address(geocoding)\n4.Locate me=> show instructions\n5Maps\n    1. Pin Vs Map Movement\n    2.Debounceing so that we dont call api on every pixel change",
      "autoResize": true,
      "lineHeight": 1.25
    },
